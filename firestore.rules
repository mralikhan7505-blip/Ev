rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Common helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Helpers
    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100));
    }

    function isValidMemory(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 2000 &&
             data.category is string && data.category.size() <= 50 &&
             data.isActive is bool;
    }

    function isValidTopic(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.category is string && data.category.size() <= 100 &&
             data.summary is string && data.summary.size() <= 3000 &&
             data.masteryPercent is int && data.masteryPercent >= 0 && data.masteryPercent <= 100 &&
             (!('keyTakeaways' in data) || (data.keyTakeaways is string && data.keyTakeaways.size() <= 3000)) &&
             (!('flashcardCount' in data) || (data.flashcardCount is int && data.flashcardCount >= 0));
    }

    function isValidFlashcard(data) {
      return data.front is string && data.front.size() > 0 && data.front.size() <= 1000 &&
             data.back is string && data.back.size() > 0 && data.back.size() <= 2000 &&
             data.isMastered is bool;
    }

    function isValidChatMessage(data) {
      return data.sender is string && (data.sender == 'user' || data.sender == 'ev') &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 25000 &&
             data.mode is string && data.mode.size() <= 50 &&
             (!('thinkingProcess' in data) || (data.thinkingProcess is string && data.thinkingProcess.size() <= 25000)) &&
             (!('searchSourcesJson' in data) || (data.searchSourcesJson is string && data.searchSourcesJson.size() <= 25000));
    }

    function isValidTask(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.description is string && data.description.size() <= 1000 &&
             data.iconName is string && data.iconName.size() <= 50 &&
             data.preferredMode is string && data.preferredMode.size() <= 50 &&
             data.promptTemplate is string && data.promptTemplate.size() > 0 && data.promptTemplate.size() <= 5000 &&
             data.requiresInput is bool;
    }

    // Rules for Users collection and subcollections
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time;
      allow update: if isOwner(userId) &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'updatedAt']);
      allow delete: if isOwner(userId);

      // Memories subcollection
      match /memories/{memoryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(memoryId) &&
                         isValidMemory(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time;
        allow update: if isOwner(userId) &&
                         isValidId(memoryId) &&
                         incoming().createdAt == existing().createdAt &&
                         isValidMemory(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'category', 'isActive', 'updatedAt']);
        allow delete: if isOwner(userId);
      }

      // Learning Topics subcollection
      match /topics/{topicId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(topicId) &&
                         isValidTopic(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time;
        allow update: if isOwner(userId) &&
                         isValidId(topicId) &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTopic(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'summary', 'masteryPercent', 'keyTakeaways', 'flashcardCount', 'updatedAt']);
        allow delete: if isOwner(userId);

        // Flashcards subcollection
        match /flashcards/{flashcardId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId) &&
                           isValidId(flashcardId) &&
                           isValidFlashcard(incoming()) &&
                           incoming().createdAt is timestamp &&
                           incoming().createdAt <= request.time;
          allow update: if isOwner(userId) &&
                           isValidId(flashcardId) &&
                           incoming().createdAt == existing().createdAt &&
                           isValidFlashcard(incoming()) &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['front', 'back', 'isMastered', 'updatedAt']);
          allow delete: if isOwner(userId);
        }
      }

      // Chat Messages subcollection
      match /chat_messages/{messageId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(messageId) &&
                         isValidChatMessage(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time;
        allow delete: if isOwner(userId);
      }

      // Learned Tasks subcollection
      match /tasks/{taskId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(taskId) &&
                         isValidTask(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time;
        allow update: if isOwner(userId) &&
                         isValidId(taskId) &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTask(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'iconName', 'preferredMode', 'promptTemplate', 'requiresInput', 'updatedAt']);
        allow delete: if isOwner(userId);
      }
    }
  }
}
